// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  INDIVIDUAL
  PROFESSIONAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(INDIVIDUAL)
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessments Assessment[]
  goals       Goal[]
  categories  Category[]   @relation("UserCategories")
  clients     Client[]     @relation("ProfessionalClients")

  accounts Account[]
  sessions Session[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  icon        String   @default("circle")
  order       Int      @default(0)
  isDefault   Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?  @relation("UserCategories", fields: [userId], references: [id])
  scores Score[]
}

model Assessment {
  id          String    @id @default(cuid())
  userId      String
  clientId    String?
  title       String    @default("Avaliação")
  status      String    @default("DRAFT") // DRAFT | COMPLETED
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])
  scores Score[]
  goals  Goal[]
}

model Score {
  id              String   @id @default(cuid())
  assessmentId    String
  categoryId      String
  value           Int      @default(5) // 0-10
  reflectionNotes String?
  createdAt       DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id])

  @@unique([assessmentId, categoryId])
}

model Goal {
  id           String   @id @default(cuid())
  assessmentId String?
  userId       String
  clientId     String?
  area         String   // Qual área da roda
  what         String   // O que fazer (5W2H)
  why          String?  // Por que fazer
  where        String?  // Onde
  when         String?  // Quando
  who          String?  // Quem
  how          String?  // Como
  cost         String?  // Quanto custará
  priority     Int      @default(1) // 1 = prioridade máxima
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  client     Client?    @relation(fields: [clientId], references: [id])
  assessment Assessment? @relation(fields: [assessmentId], references: [id])
  habits     Habit[]
}

model Habit {
  id         String   @id @default(cuid())
  goalId     String
  action     String   // "Eu vou [AÇÃO]"
  time       String?  // "às [HORA]"
  place      String?  // "em [LUGAR]"
  streak     Int      @default(0)
  bestStreak Int      @default(0)
  createdAt  DateTime @default(now())

  goal      Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habitLogs HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model Client {
  id             String   @id @default(cuid())
  professionalId String
  name           String
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional User         @relation("ProfessionalClients", fields: [professionalId], references: [id])
  assessments  Assessment[]
  goals        Goal[]
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
