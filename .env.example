# ─── Configuração de Ambiente ──────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores

# ─── Banco de Dados ───────────────────────────────────────────────────
# Opção 1 — Local (desenvolvimento): SQLite no diretório
DATABASE_URL="file:./dev.db"

# Opção 2 — Produção (Turso): descomente e configure com seus dados
# DATABASE_URL="libsql://roda-da-vida-SEU_USUARIO.turso.io?authToken=SEU_TOKEN"

# ─── Autenticação ─────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="seu-secret-aqui-mude-em-producao"
