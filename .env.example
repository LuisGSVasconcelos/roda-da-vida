# ─── Banco de Dados ──────────────────────────────────────────────
# Local (desenvolvimento): SQLite no diretório do projeto
# Render (produção):      file:/data/dev.db (persistent disk)
DATABASE_URL="file:./dev.db"

# ─── Autenticação ─────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
# Render gera automaticamente (generateValue: true no render.yaml)
AUTH_SECRET="seu-secret-aqui-mude-em-producao"
